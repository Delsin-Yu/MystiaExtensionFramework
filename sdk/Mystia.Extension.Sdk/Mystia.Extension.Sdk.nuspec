<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>Mystia.Extension.Sdk</id>
    <version>2.0.0</version>
    <authors>Delsin-Yu</authors>
    <description>MSBuild SDK and contract for Mystia's Izakaya community mods. Unofficial. Does not modify the Steam game.</description>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Delsin-Yu/MystiaExtensionFramework</projectUrl>
    <repository type="git" url="https://github.com/Delsin-Yu/MystiaExtensionFramework.git" />
  </metadata>
  <files>
    <file src="Sdk\Sdk.props" target="Sdk" />
    <file src="Sdk\Sdk.targets" target="Sdk" />
    <file src="$SdkDll$" target="lib\net10.0" />
    <file src="$GeneratorDll$" target="analyzers\dotnet\cs" />
    <file src="$AnalyzerDll$" target="analyzers\dotnet\cs" />
    <file src="..\..\README.md" target="README.md" />
    <file src="..\..\LICENSE" target="LICENSE" />
  </files>
</package>
