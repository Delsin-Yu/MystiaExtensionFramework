<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mystia.Modding.Bridge</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The bridge installs its seams and entity ports from module initializers on purpose. -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Mystia.Net.Sdk.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Mystia.Modding.Host</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mystia.Net.Sdk\Mystia.Net.Sdk.csproj" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.3" />
    <PackageReference Include="Il2CppInterop.HarmonySupport" Version="1.5.3" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Game\**\*.cs" />
    <Compile Include="Game\**\*.cs" Condition="Exists('$(MystiaInteropDir)Assembly-CSharp.dll')" />
  </ItemGroup>
  <Target Name="AliasMonoModIced" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'MonoMod.Iced'">
        <Aliases>mmiced</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>
  <ItemGroup Condition="Exists('$(MystiaInteropDir)Assembly-CSharp.dll')">
    <MystiaInteropDll Include="$(MystiaInteropDir)*.dll" />
    <Reference Include="@(MystiaInteropDll)">
      <HintPath>%(FullPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
